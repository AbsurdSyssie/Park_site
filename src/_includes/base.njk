{#-
  Base layout for every page. Practices should not need to edit this file:
  everything practice-specific comes from practice/practice.yaml.

  The shared urgent help panel is shown on Home and Appointments only under
  the approved Park Medical Centre site-structure decision.
-#}
{% extends "nhsuk/template.njk" %}
{% from "nhsuk/components/header/macro.njk" import header %}
{% from "nhsuk/components/footer/macro.njk" import footer %}
{% from "nhsuk/components/environment-banner/macro.njk" import environmentBanner %}
{% from "partials/current-breadcrumb.njk" import appendBreadcrumbAncestors, currentBreadcrumb %}

{% set assetPath = "/assets" %}
{% set p = practice.practice %}

{% set navItems = [
  { text: "Home", href: "/" },
  { text: "Request An Appointment / Admin Query", href: "/appointments/" },
  { text: "Join The Surgery", href: "/register/" },
  { text: "Patient Feedback", href: "/feedback/" },
  { text: "Test Results", href: "/test-results/" },
  { text: "Prescriptions", href: "/prescriptions/" },
  { text: "Fit notes", href: "/fit-notes/" },
  { text: "Opening times", href: "/opening-times/" },
  { text: "Contact us", href: "/contact/" },
  { text: "Services and support", href: "/services/" },
  { text: "About the practice", href: "/about/" },
  { text: "Practice news", href: "/news/" }
] %}
{% set currentNav = [] %}
{% for item in navItems %}
  {% set currentNav = (currentNav.push({ text: item.text, href: item.href, current: page.url == item.href }), currentNav) %}
{% endfor %}

{% block pageTitle %}{% if seo_title %}{{ seo_title | escape }}{% else %}{% if title and page.url != "/" %}{{ title | escape }} - {% endif %}{{ p.name | escape }}{% endif %}{% endblock %}

{% block head %}
  <meta name="description" content="{{ (description or p.description or p.name) | escape }}">
  {% if draftPreview %}<meta name="robots" content="noindex, nofollow">{% elif not searchIndexingEnabled %}<meta name="robots" content="noindex">{% endif %}
  {% if searchIndexingEnabled and page.url != "/404.html" and page.outputPath and page.outputPath.endsWith(".html") %}
    {% set canonical = page.url | canonicalUrl %}
    {% if canonical %}<link rel="canonical" href="{{ canonical | escape }}">{% endif %}
  {% endif %}
  <link rel="stylesheet" href="/assets/nhsuk-frontend.min.css">
  <link rel="stylesheet" href="/assets/practice.css">
  <script type="module" src="/assets/init.js"></script>
{% endblock %}

{% block header %}
  {% if draftPreview %}
    {{ environmentBanner({
      tag: "Unofficial demo",
      text: "Demonstration only, not the official practice website. Not approved by the practice. This site does not collect patient information.",
      colour: "yellow"
    }) }}
  {% elif practice.demo %}
    {{ environmentBanner({
      tag: "Demo",
      text: "This is a demonstration website for a fictional GP practice. None of the people, places or phone numbers are real.",
      colour: "yellow"
    }) }}
  {% endif %}
  {{ header({
    logo: {
      href: "/",
      src: practice.site.logo if practice.site and practice.site.logo else undefined,
      alt: (p.name ~ " logo") if practice.site and practice.site.logo else "NHS"
    },
    organisation: {
      name: p.name,
      split: p.name_split,
      descriptor: p.descriptor
    },
    navigation: {
      items: currentNav,
      toggleMenuText: "Browse More",
      toggleMenuVisuallyHiddenText: ""
    }
  }) }}
{% endblock %}

{% block beforeContent %}
  {% if page.url != "/" %}
    {% set breadcrumbItems = [{ href: "/", text: "Home" }] %}
    {{ appendBreadcrumbAncestors({ breadcrumbParent: breadcrumbParent }, collections.all, breadcrumbItems, [], 0) }}
    {{ currentBreadcrumb(breadcrumbItems, title) }}
  {% endif %}
{% endblock %}

{% block content %}
  {{ content | safe }}
{% endblock %}

{% block footer %}
  {% if page.url == "/" or page.url == "/appointments/" %}
    {% include "partials/urgent-help.njk" %}
  {% endif %}
  {% set cqcFooterColumn %}
    {% if practice.cqc and practice.cqc.embed_html %}
      <div class="app-cqc-footer" role="group" aria-label="Care Quality Commission rating">
        <!-- html-validate-disable-next script-type -->
        {{ practice.cqc.embed_html | safe }}
      </div>
    {% endif %}
  {% endset %}
  {{ footer({
    navigation: [
      {
        heading: { text: "Getting help" },
        items: [
          { href: "/appointments/", text: "Appointments and contact us online" },
          { href: "/prescriptions/", text: "Prescriptions" },
          { href: "/test-results/", text: "Test results" },
          { href: "/urgent-help/", text: "Urgent help" }
        ]
      },
      {
        heading: { text: "The practice" },
        items: [
          { href: "/opening-times/", text: "Opening times" },
          { href: "/contact/", text: "Contact and find us" },
          { href: "/register/", text: "Register with us" },
          { href: "/our-team/", text: "Our team" },
          { href: "/about/", text: "About the practice" },
          { href: "/feedback/", text: "Patient feedback" }
        ]
      },
      {
        heading: { text: "Policies" },
        items: [
          { href: "/practice-policies/", text: "Practice policies and information" },
          { href: "/complaints/", text: "Complaints" },
          { href: "/privacy-notice/", text: "Privacy notice" },
          { href: "/accessibility-statement/", text: "Accessibility statement" },
          { href: "/cookies/", text: "Cookies" }
        ]
      },
      {
        width: "one-quarter",
        html: cqcFooterColumn | safe
      }
    ],
    meta: {
      text: ("Practice code " ~ p.ods_code ~ ".") if draftPreview else ("Website content last reviewed " ~ (practice.site.content_last_reviewed | ukDate(false)) ~ ". Practice code " ~ p.ods_code ~ ".")
    },
    copyright: { text: "" if draftPreview else ("© " ~ p.name) }
  }) }}
{% endblock %}
